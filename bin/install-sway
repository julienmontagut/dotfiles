#!/usr/bin/env bash
set -eu

if [ "$(uname -s)" != Linux ]; then
    echo "Linux only." >&2
    exit 1
fi

# Minimal set for Debian 13+ (trixie): swaybg is pulled by sway, swayidle/swaylock aren't.
packages=(
    fuzzel
    kanshi
    keyd
    pavucontrol
    sway
    swayidle
    swaylock
    waybar
    wl-clipboard
)

sudo apt update
# Per-package fallback so a package missing on Ubuntu is skipped, not fatal.
sudo apt install -y "${packages[@]}" || for pkg in "${packages[@]}"; do
    sudo apt install -y "$pkg" || echo "skip: $pkg unavailable" >&2
done

if command -v keyd >/dev/null && ! systemctl is-enabled keyd &>/dev/null; then
    sudo systemctl enable --now keyd
fi
