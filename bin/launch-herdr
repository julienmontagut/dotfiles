#!/bin/sh
# Launch herdr, but survive it.
# If the shim is missing or herdr exits non-zero (e.g. a broken update), fall back to a login shell.
shim="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims/herdr"
if [ -x "$shim" ]; then
    "$shim" "$@"
    status=$?
    [ "$status" -eq 0 ] && exit 0
    printf '\nherdr exited with status %d. Falling back to your shell.\n' "$status" >&2
fi
exec "${SHELL:-/bin/sh}" -l
