#!/bin/sh
# Launch herdr, but survive it. Used as Ghostty's `command` and by zshrc on SSH
# login. If the shim is missing or herdr exits non-zero (e.g. a broken update),
# fall back to a login shell so the window/SSH session stays open - herdr's own
# error is already on screen, we just add the code.
# HERDR_LAUNCH_TRIED marks that a launch was attempted, so the fallback login
# shell (which re-sources zshrc and re-enters this script) doesn't loop.
# Ghostty runs this via /bin/sh with no mise on PATH, hence the absolute shim path.
# ponytail: honors MISE_DATA_DIR, else the default mise data dir.
export HERDR_LAUNCH_TRIED=1
shim="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims/herdr"
if [ -x "$shim" ]; then
    "$shim" "$@"
    status=$?
    [ "$status" -eq 0 ] && exit 0
    printf '\nherdr exited with status %d. Falling back to your shell.\n' "$status" >&2
fi
exec "${SHELL:-/bin/sh}" -l
