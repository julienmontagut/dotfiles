# Lock screen. swaylock's built-in default is pure white, which is blinding at night.
# See: man 5 swaylock
#
# swaylock is invoked as `swaylock -f` from the sway config and from swayidle, both of which
# read this file. Colors are RGB(A) without a leading '#'.

indicator-caps-lock
indicator-radius=90
indicator-thickness=8
font=Lilex Nerd Font

# Rosé Pine
color=191724
inside-color=1f1d2e
inside-clear-color=1f1d2e
inside-caps-lock-color=1f1d2e
inside-ver-color=1f1d2e
inside-wrong-color=1f1d2e

ring-color=26233a
ring-clear-color=f6c177
ring-caps-lock-color=f6c177
ring-ver-color=9ccfd8
ring-wrong-color=eb6f92

key-hl-color=c4a7e7
bs-hl-color=eb6f92
caps-lock-key-hl-color=c4a7e7
caps-lock-bs-hl-color=eb6f92

text-color=e0def4
text-clear-color=e0def4
text-caps-lock-color=e0def4
text-ver-color=e0def4
text-wrong-color=e0def4

separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
