# Display arrangement. Started from sway/config; it watches for hotplug and reapplies.
# See: man 5 kanshi
#
# A profile matches when exactly its outputs are connected, so there is one profile per
# real desk, not one per monitor. Externals are matched on "make model serial" because
# DP-3 and DP-5 are whichever port the cable went into that morning; the internal panel
# is matched on eDP-1, which is stable. Print the identifiers with:
#
#   swaymsg -t get_outputs
#
# Positions are logical pixels, so a scale-2 panel is half its mode. Scale itself is
# deliberately not set here: sway/config owns it, and kanshi leaves attributes a profile
# does not name alone. Anything not listed below falls through to sway's own defaults,
# which stack outputs left to right - fine for a monitor seen once.

profile laptop {
    output eDP-1 enable
}

# Desk: Apple Studio Display alone, lid panel off. The 5K panel is 27" at 218dpi, so scale 2
# gives the same 1x-equivalent size as the laptop and a 2560x1440 logical desktop.
#
# This is the one profile that names an external by connector instead of "make model serial",
# and it has to. The display comes up as *two* connected heads carrying identical make, model
# and serial: the real 5120x2880 stream on DP-1, and a second head on DP-2 offering nothing but
# 2560x2880, one half of the 5K tile. Both are static connectors with their own AUX channel and
# DDC, so the names belong to the ports and do not shuffle the way a dock's MST branches do.
#
# An identifier cannot tell those two heads apart, and kanshi resolves the ambiguity by position
# rather than by fit: it walks a profile's entries and gives each one the first head it matches
# in the compositor's connection order, with no backtracking and no idea which modes were asked
# for. So the identifier lands on whichever of the two heads was enumerated first, and that
# differs between session start and hotplug - every plug-in handed it to DP-2, the 5120x2880
# mode did not fit, and kanshi threw the whole configuration away and left sway's defaults lit
# on both panels. Naming each head outright is what removes the choice.
#
# Worth knowing before editing: kanshi's parser *prepends* each non-wildcard entry, so a profile
# is matched bottom-up while "*" is matched last regardless. That only matters when two entries
# can claim the same head - here none can, which is the point.
#
# Three entries, so the profile matches exactly three heads: plugging a Dell in as well falls
# through rather than blanking it. If the display ever moves to another port the names go with
# it, nothing matches, and sway's defaults come back - visibly wrong rather than silently half
# applied. `swaymsg -t get_outputs` prints the new pair.
profile desk {
    output eDP-1 disable
    output DP-2 disable
    output DP-1 enable mode 5120x2880 position 0,0 scale 2
}

# Desk: lid panel off, P2219H left, P2217H right. Both externals are scale 1, so the second
# starts at the first's full 1920.
profile peaksys {
    output eDP-1 disable
    output "Dell Inc. DELL P2219H DVPL9P2" enable position 0,0
    output "Dell Inc. DELL P2217H 0G2TG72S32MB" enable position 1920,0

    # Workspace 5 is the only one sway assigns to the left panel, so it holds what gets glanced
    # at rather than typed into, and tabbed is the layout that suits it: each window is a
    # full-width tab instead of a slice of 1920 pixels. $mod+t still toggles back to a split.
    #
    # Sway has no directive for a workspace's default layout, and an empty workspace is destroyed
    # the moment its output goes away, so a login-time swaymsg would not survive the first
    # undock. Hanging it off the profile reapplies it exactly when the panel comes back.
    # back_and_forth returns to whichever workspace was focused, so a redock does not move you.
    exec swaymsg 'workspace 5; layout tabbed; workspace back_and_forth'
}

