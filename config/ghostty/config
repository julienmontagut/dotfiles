# Icon
macos-icon = custom-style
macos-icon-ghost-color = #c4a2e0
macos-icon-screen-color = #7ca2d8

# Theme
theme = basalt-dark

# Opacity
background-opacity = 0.95

# Don't prompt to close while a multiplexer (herdr) is running.
confirm-close-surface = false

# Font
font-family = Lilex
font-size = 16

# Shell integration
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,cursor,sudo,title

# Launch herdr via its mise shim (works without shell activation, unlike a bare
# `herdr` which Ghostty runs through /bin/sh with no mise on PATH); fall back to
# the default login shell if it's missing.
# ponytail: hardcoded default mise data dir, adjust if MISE_DATA_DIR is set.
command = [ -x "$HOME/.local/share/mise/shims/herdr" ] && exec "$HOME/.local/share/mise/shims/herdr" || exec "${SHELL:-/bin/sh}" -l

# Keybindings
# keybind = super+shift+n=new_window
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
