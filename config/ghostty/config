# Icon
macos-icon = custom-style
macos-icon-ghost-color = #c4a7e7
macos-icon-screen-color = #9ccfd8

# Theme. Both are Ghostty built-ins, and the light:/dark: form follows the OS appearance.
# The basalt-* files in themes/ still work as a `theme = basalt-dark` one-liner.
theme = light:Rose Pine Dawn,dark:Rose Pine
# theme = basalt-dark

# Opacity
background-blur = true
# background-opacity = 0.95

# Don't prompt to close while a multiplexer (herdr) is running.
confirm-close-surface = false

# Font
font-family = Lilex
font-size = 16

# Shell integration
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,cursor,sudo,title

# herdr, or bash if it's missing or crashes. Must stay ONE simple command: macOS prefixes it with
# `exec -l`, so a bare `[ ... ] && ...` here execs /bin/[ and the window dies instantly.
command = /bin/sh -c '"$HOME/.local/share/mise/shims/herdr" || exec bash -l'

# Keybindings
# keybind = super+shift+n=new_window
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
