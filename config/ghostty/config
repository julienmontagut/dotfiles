# Icon
macos-icon = custom-style
macos-icon-ghost-color = #c4a2e0
macos-icon-screen-color = #7ca2d8

# Theme
theme = basalt-dark

# Opacity
background-opacity = 0.95

# Don't prompt to close while a multiplexer (herdr) is running.
confirm-close-surface = false

# Font
font-family = Lilex
font-size = 16

# Shell integration
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,cursor,sudo,title

# Launch herdr via a wrapper that falls back to the login shell when herdr is
# missing or crashes. See bin/ghostty-herdr.
command = exec "$HOME/.local/bin/ghostty-herdr"

# Keybindings
# keybind = super+shift+n=new_window
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
