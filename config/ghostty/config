# Icon
macos-icon = custom-style
macos-icon-ghost-color = #c4a7e7
macos-icon-screen-color = #9ccfd8

# Theme. Both are Ghostty built-ins, and the light:/dark: form follows the OS appearance.
# The basalt-* files in themes/ still work as a `theme = basalt-dark` one-liner.
theme = light:Rose Pine Dawn,dark:Rose Pine
# theme = basalt-dark

# Opacity
background-blur = true

# Don't prompt to close while a multiplexer (herdr) is running.
confirm-close-surface = false

# Exit with the last window instead of idling in the Dock, so a workspace that looks empty is.
# The consequence: hyper+enter is often a cold start rather than an AppleScript `new window`,
# which is exactly why that binding is guarded by pgrep. See config/aerospace/aerospace.toml.
quit-after-last-window-closed = true

# Font
font-family = Lilex
font-size = 16

# Shell integration
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,cursor,sudo,title

# Keybindings
# keybind = super+shift+n=new_window
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
