// Rosé Pine bar for Waybar - the Linux half of the pair. Mirrors config/sketchybar/sketchybarrc:
// no bar, just smoked-glass capsules floating on the desktop - workspaces and the focused window
// left, system cluster and clock right. Same Nerd Font glyphs, same palette. Change the shape of
// the bar there, change it here.
//
// Nothing is centred, which on Linux buys nothing on its own - it is the notched Mac that cannot
// use its centre. Keeping the two in step is worth more than reclaiming the space here.
//
// Five workspaces, fixed and anonymous, same five as aerospace: the name is the digit, and the
// digit is also the keybinding ($mod+1..5 here, hyper+N on macOS). Scratch is sway's native
// scratchpad on $mod+minus, which is not a workspace and so never appears here.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    // 0, so the modules inside one pill touch and the dividers land between them. Gaps between
    // pills are margins in style.css, not spacing here.
    "spacing": 0,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": [],
    "modules-right": ["tray", "network", "cpu", "memory", "battery", "pulseaudio", "clock#time", "clock#date"],

    "clock#time": {
        "format": "󰅐 {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "clock#date": {
        "format": "󰃭 {:%d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        // Sway only reports workspaces that exist, so without this the row would grow and shrink
        // as workspaces empty out. The five are fixed; they are always all drawn.
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    // app_id, not title, so this says the same thing sketchybar's centre item says: what is
    // focused, not what it happens to be showing. XWayland windows report no app_id and fall
    // back to the bare glyph.
    "sway/window": {
        "format": "󰖸 {app_id}",
        "max-length": 50,
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "states": {
            "warning": 50,
            "critical": 80
        },
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "states": {
            "warning": 50,
            "critical": 80
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-plugged": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
            "charging": ["󰂆", "󰂈", "󰂉", "󰂊", "󰂅"]
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 10
    }
}
