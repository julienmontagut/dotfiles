// Rosé Pine bar for Waybar - the Linux half of the pair. Mirrors config/sketchybar/sketchybarrc:
// workspaces and the focused window left, system cluster and clock right. Same Nerd Font glyphs
// (Material Design, from Lilex Nerd Font), same palette, same module order. The chrome differs -
// sketchybar draws one opaque strip, this floats above the wallpaper as a row of pills - because
// sway has 10px gaps and a wallpaper worth seeing and macOS has neither. Change which modules
// exist or what order they sit in there, change it here.
//
// Nothing is centred, which on Linux buys nothing on its own - it is the notched Mac that cannot
// use its centre. Keeping the two in step is worth more than reclaiming the space here.
//
// Five workspaces, fixed and anonymous, same five as aerospace: the name is the digit, and the
// digit is also the keybinding ($mod+1..5 here, hyper+N on macOS). Scratch is sway's native
// scratchpad on $mod+minus, which is not a workspace and so never appears here.
//
// The tray holds nm-applet and blueman-applet (started from sway/config). Those two are here for
// their agents - the wifi password prompt and the bluetooth pairing prompt GNOME used to supply -
// and their menus. The network and bluetooth modules repeat the icon on purpose: those are the
// glanceable status, the tray icons are the menus.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    // The bar floats on the same 10px frame the windows do: `gaps inner 10` in the sway config
    // puts a window 10px off the screen edge, and these put the bar there too, so the two line up
    // on the left and right. Sway reserves height + margin-top, so the first window still clears
    // the bar by the same 10px.
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    // 0: the pills carry their own margins in style.css, and a box spacing here would add to them
    // asymmetrically at the ends.
    "spacing": 0,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": [],
    // Four pills: tray, machine state, devices, clock. Grouping them here rather than drawing
    // dividers in CSS means a module can be moved between clusters without a matching CSS edit,
    // and an empty module (sway/mode at rest) takes its whole pill with it when it hides.
    "modules-right": ["tray", "group/machine", "group/devices", "group/time"],

    // The group names are the CSS ids: #machine, #devices, #time. Keep them distinct from the
    // module ids inside them (#cpu, #network, #clock) or the pill and its contents share a rule.
    "group/machine": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "custom/powerprofile", "cpu", "memory"]
    },

    "group/devices": {
        "orientation": "horizontal",
        "modules": ["backlight", "pulseaudio", "bluetooth", "network", "battery"]
    },

    "group/time": {
        "orientation": "horizontal",
        "modules": ["clock#time", "clock#date"]
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        // Sway only reports workspaces that exist, so without this the row would grow and shrink
        // as workspaces empty out. The five are fixed; they are always all drawn.
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": [], "5": []
        }
    },

    "sway/mode": {
        "format": "{}"
    },

    // app_id, not title, so this says the same thing sketchybar's centre item says: what is
    // focused, not what it happens to be showing. XWayland windows report no app_id and fall
    // back to the bare glyph. An empty workspace produces an empty label, and Waybar hides an
    // empty label, so the pill disappears with it.
    "sway/window": {
        "format": "󰖸 {app_id}",
        "max-length": 50,
        "tooltip": false
    },

    // Click to keep the screen awake through a presentation or a screen share, which is the one
    // thing swayidle cannot work out on its own.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Idle inhibited",
        "tooltip-format-deactivated": "Idle not inhibited"
    },

    // Ubuntu's waybar 0.9.24 is built without upstream's power-profiles-daemon module (it warns
    // "Unknown module" if you try), so this drives powerprofilesctl through bin/power-profile.
    // The signal is what makes a click redraw immediately instead of at the next interval.
    "custom/powerprofile": {
        "exec": "$HOME/.local/bin/power-profile",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "{icon}",
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        },
        "on-click": "$HOME/.local/bin/power-profile next && pkill -RTMIN+8 waybar"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "states": { "warning": 50, "critical": 80 },
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "states": { "warning": 50, "critical": 80 }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰝟 {icon}",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "hands-free": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "tooltip-format": "{desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\n{status}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "clock#time": {
        "format": "󰅐 {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "clock#date": {
        "format": "󰃭 {:%d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
