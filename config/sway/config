# Sway configuration
# See: man 5 sway

# =============================================================================
# Variables
# =============================================================================

# Alt (mod1) instead of Super (mod4)
set $mod Mod1

# Default app and programs. $term prefers ghostty because foot 1.16.2, the only version noble
# ships, re-sends the legacy byte on key release under the kitty keyboard protocol: Enter,
# Backspace and Tab then arrive twice in anything enabling it - neovim, herdr, claude code.
# sway hands these lines to sh, so the substitution resolves at launch, and fuzzel gets an
# absolute path because sh expands it before fuzzel is spawned. Drop the $(...) once foot is fixed.
set $term "$(command -v ghostty || command -v foot)"
set $menu fuzzel --terminal $term
set $browser google-chrome-stable

# =============================================================================
# Output configuration
# =============================================================================

# Wallpaper. swaybg renders it; swaylock reuses the same file, hence the variable. `fill` crops
# to the output's aspect ratio, and the base colour behind it covers the moment before swaybg is
# up and any output swaybg cannot draw. sway runs the path through wordexp, so $HOME resolves.
set $wallpaper $HOME/.config/wallpapers/rose-pine-maze.png
output * bg $wallpaper fill #191724

# TODO: Set default as 1 and replace next one with vivobook panel name
output eDP-1 scale 2
output "Chimei Innolux Corporation 0x143B Unknown" scale 1

# =============================================================================
# Input configuration
# =============================================================================

input "type:keyboard" {
    xkb_layout us
    xkb_variant dvorak
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

input "type:pointer" {
    natural_scroll disabled
}

focus_follows_mouse yes
# mouse_warping container

# =============================================================================
# Appearance
# =============================================================================

# One 10px rhythm across the session: waybar floats 10px off the screen edge (margin-* in
# config/waybar/config), notifications do too (outer-margin in config/mako/config), and windows
# sit 10px apart and 10px off the edge.
#
# outer stays 0 because sway *adds* inner to outer at the workspace edge - `outer 5` with
# `inner 10` gives a 15px frame around a 10px gap, which is the one combination that looks
# wrong. Raise outer only to make the frame deliberately wider than the gaps.
gaps inner 10
gaps outer 0

# Borders are the only thing marking focus once the gaps are this wide, so they stay at 2px and
# only the focused window draws one in a colour - see the palette below.
default_border pixel 2
default_floating_border pixel 2

# Titlebars only appear in the tabbed layout, which is workspace 5's default. Sway's own default
# font is "monospace 10"; this is the same size in the font everything else here uses.
font pango:Lilex Nerd Font Mono 10
titlebar_padding 10 4
titlebar_border_thickness 0

# Colors (Rosé Pine). Only the focused window is coloured: it takes iris, everything else recedes
# into the surface and overlay greys so a screen of tabs reads as one dark strip with one lit tab.
# `background` is what sway paints where no client has drawn yet.
# class                 border  backgr. text    indicator child_border
client.focused          #c4a7e7 #c4a7e7 #191724 #c4a7e7   #c4a7e7
client.focused_inactive #403d52 #26233a #e0def4 #403d52   #403d52
client.unfocused        #26233a #1f1d2e #908caa #26233a   #26233a
client.urgent           #eb6f92 #eb6f92 #191724 #eb6f92   #eb6f92
client.background       #191724

# Colors (Rosé Pine Dawn)
# client.focused          #907aa9 #907aa9 #faf4ed #907aa9   #907aa9
# client.focused_inactive #dfdad9 #f2e9e1 #575279 #dfdad9   #dfdad9
# client.unfocused        #f2e9e1 #fffaf3 #797593 #f2e9e1   #f2e9e1
# client.urgent           #b4637a #b4637a #faf4ed #b4637a   #b4637a
# client.background       #faf4ed

# Colors (Basalt Dark)
# client.focused          #7ca2d8 #7ca2d8 #0e0e0e #7ca2d8   #7ca2d8
# client.focused_inactive #3e3e44 #1c1c1c #e7e5e5 #3e3e44   #3e3e44
# client.unfocused        #1c1c1c #131313 #acabaa #1c1c1c   #1c1c1c
# client.urgent           #d87c7c #d87c7c #0e0e0e #d87c7c   #d87c7c
# client.background       #0e0e0e

# =============================================================================
# Key bindings - Basics
# =============================================================================
#
# House rules: $mod plus a single key for anything used daily, the mnemonic key
# where one exists, and Shift for the variant of a binding (move vs focus,
# fullscreen vs float) or for anything destructive.

# Launchers. Bound directly rather than behind a mode, same three apps and same keys as aerospace.
# Each exec of a single-instance GTK app opens a window in the running process, so none of the
# macOS new-window trouble applies here.
bindsym $mod+Return exec $term
bindsym $mod+b exec $browser
bindsym $mod+z exec zed

# Launcher
bindsym $mod+space exec $menu

# Close focused window
bindsym $mod+Escape kill

# Lock the session. $lock rather than a bare swaylock because swayidle below runs the same
# command twice more, and because swaylock does not expand `~` or `$HOME` in its own config file -
# the image has to reach it on the command line, where sway's `exec` hands it to sh.
set $lock swaylock -f -i "$wallpaper"
bindsym $mod+Shift+backslash exec $lock

# Reload config
bindsym $mod+Shift+c reload

# Exit sway. Shift of the close-window key, and it asks first. The confirmation
# is fuzzel rather than swaynag: swaynag is pointer-only (it does not even link
# libxkbcommon), and fuzzel is already the launcher. Cancel is preselected, so
# Return or Escape both back out.
bindsym $mod+Shift+Escape exec printf 'Cancel\nExit sway' | fuzzel --dmenu --lines 2 --prompt 'Exit sway? ' | grep -qx 'Exit sway' && swaymsg exit

# Drag with $mod held to move a floating window, right-drag to resize
floating_modifier $mod normal

# =============================================================================
# Key bindings - Navigation
# =============================================================================

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Focus the containing split
bindsym $mod+a focus parent

# Flatten one redundant wrapper. Pressing $mod+s or $mod+v and then opening a
# window leaves a split container holding a single child, and those stack up as
# V[H[H[foot firefox]]]. sway has no auto-flatten and `split none` only dissolves
# a container with no siblings, so this peels one level per press; repeat until
# the nesting is gone. It is a no-op once flat. The one level it cannot remove is
# a wrapper sitting directly under the workspace: move a window out of it with
# $mod+Shift+h or l first, then press this on what is left.
bindsym $mod+Shift+a focus parent; split none; focus child

# =============================================================================
# Key bindings - Workspaces
# =============================================================================

# Where the workspaces live on the two-monitor desk. The right panel is the one straight ahead,
# so it holds the four working workspaces; the left one is peripheral and holds a single
# workspace for what gets glanced at rather than typed into - chat, mail, logs, a reference
# page. Sway takes the first output in the list that is actually connected, so eDP-1 is the
# fallback and the laptop on its own still gets all five.
#
# A workspace is assigned when it is created, never retroactively, so a reload leaves the
# current ones where they already are. Switching away from an empty one destroys it and the
# next visit puts it on the right panel.
set $main "Dell Inc. DELL P2217H 0G2TG72S32MB"
set $side "Dell Inc. DELL P2219H DVPL9P2"

workspace 1 output $main eDP-1
workspace 2 output $main eDP-1
workspace 3 output $main eDP-1
workspace 4 output $main eDP-1
workspace 5 output $side eDP-1

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

# Focus follows the window, matching aerospace's --focus-follows-window. Sway has no such flag, so
# the two commands are chained.
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5

# Cycle workspaces
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

# Scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# =============================================================================
# Key bindings - Layout
# =============================================================================

# Split, named after neovim's :split and :vsplit. Those are the mirror of sway's
# own names: vim's split stacks two windows, which sway calls splitv.
bindsym $mod+s splitv
bindsym $mod+v splith

# Tabbed layout, and the same key back out of it
bindsym $mod+t layout toggle tabbed split

# Float the focused window, or let it fill the screen
bindsym $mod+f floating toggle
bindsym $mod+Shift+f fullscreen

# =============================================================================
# Key bindings - Media
# =============================================================================
#
# wpctl ships with pipewire, which is what this machine runs. --locked keeps these working
# while swaylock is up.

# -l 1.0 caps the sink at 100%: pipewire will happily amplify past it and distort.
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# brightnessctl is built without logind support, so it writes to /sys through the group the
# udev rule grants. `mise bootstrap` adds the user to it; that needs a fresh login to apply.
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# =============================================================================
# Key bindings - Screenshots and notifications
# =============================================================================
#
# Screenshots go to the clipboard rather than to disk: one is nearly always on its way into a
# chat window, and wl-copy holds it until it is pasted. Print is duplicated onto $mod+p
# because it needs Fn on this keyboard.

bindsym $mod+p exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+p exec grim - | wl-copy
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

bindsym $mod+n exec makoctl dismiss
bindsym $mod+Shift+n exec makoctl dismiss --all
# Do not disturb, the equivalent of GNOME's switch. See the mode block in config/mako/config.
# makoctl has no toggle, so this reads the current modes and flips the one it cares about.
bindsym $mod+Ctrl+n exec makoctl mode | grep -qx do-not-disturb && makoctl mode -r do-not-disturb || makoctl mode -a do-not-disturb

# =============================================================================
# Key bindings - Resize mode
# =============================================================================

mode "resize" {
    bindsym h resize shrink width 100 px
    bindsym j resize grow height 100 px
    bindsym k resize shrink height 100 px
    bindsym l resize grow width 100 px

    bindsym Left resize shrink width 100 px
    bindsym Down resize grow height 100 px
    bindsym Up resize shrink height 100 px
    bindsym Right resize grow width 100 px

    bindsym Escape mode "default"
    bindsym Return mode "default"
}

bindsym $mod+r mode "resize"

# =============================================================================
# Status bar
# =============================================================================

# Use waybar instead of swaybar
bar {
    swaybar_command waybar
}

# =============================================================================
# Startup
# =============================================================================

# First: 50-systemd-user.conf in here pushes WAYLAND_DISPLAY and SWAYSOCK into the systemd
# user manager, which the exec below builds on. sway runs execs in config order.
include /etc/sway/config.d/*

# xdg-desktop-portal chooses its backend from XDG_CURRENT_DESKTOP, and the systemd user manager
# starts at login, before sway, so it never sees it, and the include above does not forward
# it either. Without this the portal answers with a backend that cannot capture a wlroots output, and
# a screen share from Chrome or Firefox has nothing to offer. The restart is for the case where
# a portal is already running from an earlier GNOME session in the same boot; one exec rather
# than two because the restart has to follow the environment update, and `exec` rather than
# `exec_always` so that reloading the config does not kill a share in progress.
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway && systemctl --user restart xdg-desktop-portal.service

# Notifications. Nothing else here implements org.freedesktop.Notifications, so without mako
# every notification (Teams, Chrome, notify-send) is dropped silently.
exec mako

# Tray agents, both of which waybar hosts. These are not just icons: nm-applet is the secret
# agent that prompts for a wifi password and blueman-applet is the pairing agent that prompts
# to confirm a headset. GNOME provided both, and nothing in sway or waybar replaces them.
exec nm-applet --indicator
exec blueman-applet

# Display arrangement, reapplied whenever a monitor is plugged or unplugged. See
# config/kanshi/config for the profiles; `swaymsg -t get_outputs` prints the identifiers.
#
# exec_always, and a restart rather than a plain start: a reload reapplies the `output` lines
# above, which relays the outputs out in sway's own order and undoes kanshi's positions. Nothing
# hotplugs, so kanshi never notices. Restarting it here reapplies the profile on every reload.
# The whole payload is quoted because sway splits a command list on `;` before exec ever sees
# it: unquoted, `kanshi` is read as a second sway command and the config errors out with
# "Unknown/invalid command 'kanshi'", leaving the outputs wherever sway itself put them.
exec_always "pkill -x kanshi; kanshi"

# Authorisation prompts. GNOME's polkit agent lives inside gnome-shell, so without a stand-in
# anything needing authorisation is refused with no dialog ever shown.
exec /usr/libexec/polkit-mate-authentication-agent-1

# Lock, then blank, then lock again before suspend. The --locked bindings above keep the volume
# and brightness keys alive while the lock screen is up, and waybar's idle inhibitor suspends
# all of it for the length of a presentation.
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'
